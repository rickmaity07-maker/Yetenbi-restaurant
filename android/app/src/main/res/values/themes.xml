<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#FF17120E</color>
    <color name="coal">#FF27201A</color>

    <!-- Splash: the gold cross on the dark background, then straight into the app. -->
    <style name="Theme.Yetenbi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Yetenbi</item>
    </style>

    <style name="Theme.Yetenbi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
