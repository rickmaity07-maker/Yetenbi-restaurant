# Copy to .env.local (and add the same variables in Vercel → Project → Settings → Environment Variables).

# Neon Postgres connection string. Without it the site still works and reservations go out via WhatsApp.
# After setting it, create the tables once (safe to repeat):  npm run db:setup
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Signing key for links in emails (e.g. cancel a booking): any long random string.
# Owner accounts for /admin are created with:  npm run owner:create -- owner@example.com "password" "Name"
ADMIN_SESSION_SECRET=a-long-random-string
# Legacy: only used as a fallback signing key when ADMIN_SESSION_SECRET is empty.
ADMIN_PASSWORD=

# "Sign in with Google" (optional). Create an OAuth client (type: Web application) at
# console.cloud.google.com/apis/credentials and add the redirect URI
#   https://<your-domain>/api/auth/google/callback   (and http://localhost:3000/api/auth/google/callback)
# Without these the Google button is hidden and guests sign in with email and password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Booking emails: a Gmail account with 2-Step Verification and an App Password
# from myaccount.google.com/apppasswords (not the normal Gmail password).
GMAIL_USER=yetenbi.example@gmail.com
GMAIL_APP_PASSWORD=your-16-letter-app-password
GMAIL_FROM_NAME=Yetenbi Restaurant & Café
# Where new requests are sent (several addresses: separate with commas).
RESERVATION_NOTIFY_EMAIL=inhaber@example.com
# Optional: another mail server instead of Gmail.
# Where server errors are emailed (at most once an hour per place). Default: RESERVATION_NOTIFY_EMAIL.
# ERROR_ALERT_EMAIL=dev@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# Name of that provider as the privacy policy should state it (shown instead of Gmail; redeploy after changing):
# MAIL_PROVIDER=Brevo (Sendinblue SAS, Frankreich)

# Photos uploaded in /admin → Fotos (cloudinary.com → Dashboard). Without these, the built-in pictures stay.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Daily data clean-up (DSGVO retention, 180 days), called by Vercel Cron.
CRON_SECRET=a-long-random-string

# Device test suite (npm run test:devices): one test login per role. Never use real staff accounts.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_KITCHEN_EMAIL=
TEST_KITCHEN_PASSWORD=
TEST_DRIVER_EMAIL=
TEST_DRIVER_PASSWORD=
TEST_GUEST_EMAIL=
TEST_GUEST_PASSWORD=

# Public URL (used for search engines and share images). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=https://yetenbi.example
